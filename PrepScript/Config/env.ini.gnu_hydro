[Environment]
SYS_CWRF           = /home/wumej22/.cresm
SYS_CoLM           = /home/wumej22/.cresm_gnu
SYS_NCL            = /home/wumej22/.cresm
SYS_ESMF           = /home/wumej22/.cresm_hydro_gnu
CONDA_CRESM        = cresm
CONDA_XESMF        = cresm_xesmf
CONDA_CHAO         = Chaomodis
CONDA_UNGRIB       = ungrid


[Paths]
ScriptPath          = /hydata01/wumej22/DONT_DELETE/CPS/PrepScript

; CoLM Related Paths
CoLMModelPath       = /hydata01/wumej22/DONT_DELETE/CoLM202X           
CoLMRawDataPath     = /shr03/CoLMrawdata
CoLMRunDataPath     = /shr03/CoLMruntime
CoLMForcingPath     = /shr03/CoLM_Forcing/ERA5LAND/

; ToolBox and Data Paths
RootToolBox         = /hydata01/wumej22/DONT_DELETE/CRESM_ToolBox
CWPSPath            = ${Paths:RootToolBox}/ToolBox.gnu_hydro/CWRF-CWPS
CWRFToolPath        = ${Paths:RootToolBox}/ToolBox.gnu_hydro/CWRF_Tools                                                            
GeogDataPath        = ${Paths:RootToolBox}/Data/CWPS_GEOG/geog_wm_modified_lake
LandSeaMaskPath     = ${Paths:RootToolBox}/Data/CWPS_GEOG/Land-and-sea-boundary-data               
CWPSStaticPath      = ${Paths:RootToolBox}/Data/CWPS_static                                                          
GlobalLakeDepth     = ${Paths:RootToolBox}/Data/CWPS_GEOG/newGlobalLakeDepth.dat                               
GlobalLakeStatus    = ${Paths:RootToolBox}/Data/CWPS_GEOG/newGlobalLakeStatus.dat
WMEJUngrib          = ${Paths:RootToolBox}/ToolBox.gnu_hydro/WMEJ_NC2IM
ChaoModis           = ${Paths:RootToolBox}/ToolBox.gnu_hydro/Chao_modis                                                           
WMEJModis           = ${Paths:RootToolBox}/ToolBox.gnu_hydro/WMEJ_modis

; External Program Paths
NCOPath             = /usr/bin/ncks
CDOPath             = /stu01/wumej22/mylibs/GNU_LIBS/build/cdo/2.6.3/bin/cdo
NCLPath             = /stu01/wumej22/Anaconda3/envs/ncl2-env/bin/ncl
ESMFWeightGenPath   = /stu01/wumej22/mylibs/GNU_LIBS.HYDRO/build/esmf/8.9.1/bin/binO/Linux.gfortran.64.mpich.default/ESMF_RegridWeightGen


[Domain]
DefaultDataName     = ERA5
DomainDataPath      = /hydata01/wumej22/DONT_DELETE/CRESM_ToolBox/Data/CWPS_GEOG/ERA5_UV_RH_Q_T_850_925_200hpa_Monmean_1991-2025.nc
VarList             = u, v, r, t, q
StudyAreaCriteria   = u:850, v:850, r:925, q:925
BoundaryFracThres   = 0.15
LevelDimName        = pressure_level
TimeDimName         = valid_time
LatDimName          = latitude
LonDimName          = longitude
AnalyzeLonMin       = 60
AnalyzeLonMax       = 140
AnalyzeLatMin       = 0
AnalyzeLatMax       = 60



[era5]
ForcingDataName     = ERA5
DataCalender        = standard
Forc_Info           = None
Forc_2D_Path        = /shr02/CRESM_Forcing/ERA5_RAW/<YYYY>/SFC<YYYY><MM><DD>.grib
Forc_3D_Path        = /shr02/CRESM_Forcing/ERA5_RAW/<YYYY>/PRESS<YYYY><MM><DD>.grib
Forc_SST_Path       = /shr02/CRESM_Forcing/ERA5_RAW/<YYYY>/SFC<YYYY><MM><DD>.grib


[cfsv2]
ForcingDataName     = CFSV2
DataCalender        = standard
Forc_Info           = None
Forc_2D_Path        = /shr02/CRESM_Forcing/CFSV2/6-hourly-flux/040100/<YYYY>/flxf<YYYY><MM><DD><HH>.01.<YYYY>040100.grb2
Forc_3D_Path        = /shr02/CRESM_Forcing/CFSV2/6-hourly-by-pressure/040100/<YYYY>/pgbf<YYYY><MM><DD><HH>.01.<YYYY>040100.grb2
Forc_SST_Path       = /shr02/CRESM_Forcing/CFSV2/6-hourly-flux/040100/<YYYY>/flxf<YYYY><MM><DD><HH>.01.<YYYY>040100.grb2


[mpi-esm1-2-hr_hist]
ForcingDataName     = MPI-ESM1-2-HR_hist
DataCalender        = standard
Forc_Info           = /hydata01/wumej22/DONT_DELETE/CRESM_ToolBox/Forcing/NetCDF_Forcing_Config/Forc_Info.MPI-ESM1-2-HR_hist.ini
Forc_2D_Path        =
Forc_3D_Path        =
